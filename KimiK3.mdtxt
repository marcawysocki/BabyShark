--- File: CustomReaperAttackMicroController.cs ---
```csharp
using SC2APIProtocol;
using Sharky;
using Sharky.DefaultBot;
using System.Collections.Generic;

namespace SharkyTerranExampleBot.MicroTasks
{
    public class CustomReaperAttackMicroController : MicroController
    {
        UnitCountService UnitCountService;
        TargetingData TargetingData;
        
        public CustomReaperAttackMicroController(DefaultSharkyBot defaultSharkyBot) : base(defaultSharkyBot)
        {
            UnitCountService = defaultSharkyBot.UnitCountService;
            // In a real implementation, TargetingData would be initialized based on enemy positions
            // For this example context, we assume it's available or calculated per frame
        }

        public override List<Action> GetActions(int frame)
        {
            var actions = new List<Action>();

            // Iterate through owned Reapers to issue attack commands
            foreach (var unit in UnitCountService.GetUnits(UnitTypes.TERRAN_REAPER))
            {
                if (unit.Unit.Tag == null || !UnitIsAlive(unit)) continue;

                // Determine target based on custom logic or proximity
                var enemyTarget = GetNearestEnemyTarget(unit.Position);
                
                if (enemyTarget != null)
                {
                    TargetingData.AttackPoint = enemyTarget.Position;
                    
                    var action = commander.Order(frame, Abilities.ATTACK, TargetingData.AttackPoint);
                    if (action != null)
                    {
                        actions.AddRange(action);
                    }
                    continue;
                }

                // Fallback: Move towards proxy or base if no target found
                // ... additional movement logic could go here
            }

            return actions;
        }

        private bool UnitIsAlive(SharkyUnit unit)
        {
            return unit != null && unit.Unit.Tag > 0;
        }

        private SharkyUnit GetNearestEnemyTarget(FPoint position)
        {
            // Simplified logic to find nearest enemy unit within range
            // In a full implementation, this would query the EnemyData or UnitCountService for enemies
            return null; 
        }
    }
}
```

### Explanation of Integration
1.  **Namespace**: Matches `SharkyTerranExampleBot.MicroTasks` (consistent with `VikingDrops.cs`).
2.  **Inheritance**: Inherits from `MicroController`, which provides access to the `commander` property used in your snippet (`commander.Order`).
3.  **Method Signature**: The provided snippet ends a method returning `List<Action>`. In Sharky, this is typically `GetActions(int frame)`.
4.  **Logic Flow**: 
    *   Iterates through units (implied by the loop structure ending in `continue` and `return actions`).
    *   Uses `Abilities.ATTACK` to order attacks.
    *   Matches the `TargetingData.AttackPoint` usage seen in your snippet, which is set when `AttackData.CustomAttackFunction = true` in `ReaperCheese.cs`.
5.  **Context**: This controller would be registered or enabled specifically when the `ReaperCheese` build starts to handle the custom attack logic required for the early Reaper push strategy.
